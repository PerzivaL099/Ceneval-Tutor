# ==============================================================================
# CONFIGURACIÓN DE BASE DE DATOS (POSTGRESQL)
# ==============================================================================
DB_USER=tu_usuario_aqui
DB_PASSWORD=tu_contrasena_segura_aqui
DB_NAME=ceneval_tutor
DB_HOST=db
DB_PORT=5432

# URL de conexión interna que utilizará SQLAlchemy / Tortoise ORM
DATABASE_URL=postgresql://tu_usuario_aqui:tu_contrasena_segura_aqui@db:5432/ceneval_tutor

# ==============================================================================
# CONFIGURACIÓN DE API CORE (FASTAPI)
# ==============================================================================
SECRET_KEY=coloca_aqui_un_hash_aleatorio_para_firmar_tokens_jwt
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==============================================================================
# CONFIGURACIÓN DE IA GENERATIVA (OLLAMA)
# ==============================================================================
